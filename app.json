{
  "expo": {
    "name": "ParentalControl",
    "slug": "parental-control-app",
    "version": "1.0.0",
    "scheme": "myapp",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.parentalcontrol",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location is shared with your family only when you send an SOS alert."
      }
    },
    "android": {
      "package": "com.example.parentalcontrol",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Location is shared with your family only when you send an SOS alert."
        }
      ],
      "expo-secure-store"
    ],
    "web": {
    }
  }
}
