{
  "expo": {
    "name": "ParentalControl",
    "slug": "parental-control-app",
    "version": "1.0.0",
    "scheme": "myapp",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.parentalcontrol",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location is shared with your family only when you send an SOS alert.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.parentalcontrol",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Location is shared with your family only when you send an SOS alert."
        }
      ],
      "expo-secure-store"
    ],
    "web": {},
    "extra": {
      "parentApiUrl": "",
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.example.parentalcontrol.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.example.parentalcontrol.screentime"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.example.parentalcontrol.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.example.parentalcontrol.screentime"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.example.parentalcontrol.ActivityMonitorExtension",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.example.parentalcontrol.screentime"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "451e619e-2bd7-4a04-b321-28c0f78a1b0e"
      }
    }
  }
}
