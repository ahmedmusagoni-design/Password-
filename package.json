{
  "name": "parental-control-app",
  "version": "0.1.0",
  "description": "React Native Expo parental control app with screen time tracking and SOS features",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest --runInBand",
    "test:api": "npm --prefix server test",
    "test:e2e:build:android": "detox build -c android.emu.debug",
    "test:e2e:android": "detox test -c android.emu.debug",
    "test:e2e:build:ios": "detox build -c ios.sim.debug",
    "test:e2e:ios": "detox test -c ios.sim.debug",
    "lint": "eslint src/ --ext .ts,.tsx"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/stack": "^6.3.0",
    "@reduxjs/toolkit": "^2.5.0",
    "expo": "~58.0.25",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-location": "~58.0.22",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.17",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-device-activity": "0.1.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-flow-strip-types": "^7.24.7",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^20.5.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "detox": "^20.0.0",
    "eslint": "^8.55.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "react-native-device-activity": {
      "expo-constants": "58.0.16"
    }
  }
}
