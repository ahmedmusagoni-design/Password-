{
  "name": "parental-control-app",
  "version": "0.1.0",
  "description": "React Native Expo parental control app with screen time tracking and SOS features",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest --runInBand",
    "test:api": "npm --prefix server test",
    "test:e2e:build:android": "detox build -c android.emu.debug",
    "test:e2e:android": "detox test -c android.emu.debug",
    "test:e2e:build:ios": "detox build -c ios.sim.debug",
    "test:e2e:ios": "detox test -c ios.sim.debug",
    "lint": "eslint src/ --ext .ts,.tsx"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/stack": "^6.3.0",
    "@reduxjs/toolkit": "^1.9.7",
    "expo": "~51.0.39",
    "expo-build-properties": "~0.12.5",
    "expo-constants": "~16.0.2",
    "expo-location": "~17.0.1",
    "expo-secure-store": "~13.0.2",
    "expo-sqlite": "~14.0.6",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-native": "0.74.5",
    "react-native-device-activity": "0.1.0",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-screens": "3.31.1",
    "react-redux": "^8.1.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-flow-strip-types": "^7.24.7",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.5.0",
    "@types/react": "~18.2.45",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "detox": "^20.0.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.3.3"
  },
  "private": true
}
